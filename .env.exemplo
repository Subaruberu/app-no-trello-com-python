# ---------------------------------------------------------------------------
# Gemini (Google AI Studio) - https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=sua-chave-do-google-ai-studio

# Opcional: troque o modelo se quiser (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Trello - https://trello.com/power-ups/admin/
# ---------------------------------------------------------------------------
TRELLO_API_KEY=sua-chave-de-api-aqui
TRELLO_API_SECRET=seu-segredo-de-api-aqui
TRELLO_TOKEN=seu-token-aqui

# Nome exato do quadro que o agente vai usar
TRELLO_BOARD_NAME=DIO

# Fuso usado para calcular as datas de vencimento
TRELLO_TIMEZONE=America/Sao_Paulo
